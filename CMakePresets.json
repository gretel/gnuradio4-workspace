{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (Homebrew LLVM)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "toolchainFile": "${sourceDir}/cmake/toolchain-macos-homebrew-llvm.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (system gcc/clang)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (LLVM MinGW / clang++)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang",
        "CONFIG_USE_FETCHCONTENT": "n",
        "CONFIG_ENABLE_HTTP": "n",
        "CONFIG_ENABLE_BLOCK_REGISTRY": "y",
        "CONFIG_ENABLE_BLOCK_PLUGINS": "y",
        "CONFIG_ENABLE_TESTING": "n",
        "CONFIG_ENABLE_GR4_ALGORITHM": "n",
        "CONFIG_ENABLE_GR4_BLOCKS": "n",
        "CONFIG_WARNINGS_AS_ERRORS": "n"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "jobs": 0
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "jobs": 0
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos",
      "steps": [
        {
          "type": "configure",
          "name": "macos"
        },
        {
          "type": "build",
          "name": "macos"
        },
        {
          "type": "test",
          "name": "macos"
        }
      ]
    },
    {
      "name": "linux",
      "steps": [
        {
          "type": "configure",
          "name": "linux"
        },
        {
          "type": "build",
          "name": "linux"
        },
        {
          "type": "test",
          "name": "linux"
        }
      ]
    },
    {
      "name": "windows",
      "steps": [
        {
          "type": "configure",
          "name": "windows"
        },
        {
          "type": "build",
          "name": "windows"
        },
        {
          "type": "test",
          "name": "windows"
        }
      ]
    }
  ]
}
